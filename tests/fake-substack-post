#!/usr/bin/env python3
"""A stand-in for substack-post that talks to nobody.

It implements the contract the plug-in relies on — kv output on stdout, the
right keys for a draft, a publish, a schedule and a --check — and records the argv it was
handed, so the Lua side can be tested without a Substack account and without
uploading anything.

The recorded arguments go to $FAKE_SUBSTACK_ARGV, defaulting to
tests/.last-argv.json beside this script's own directory.
"""

import json
import os
import sys
import time

DEFAULT_RECORD = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              ".last-argv.json")


def progress_file(args):
    if "--progress-file" not in args:
        return None
    return args[args.index("--progress-file") + 1]


def report_progress(path) -> None:
    """Move through a few positions slowly enough for a poller to see them.

    The real tool writes one position per step of the run; what matters to the
    plug-in is that the file changes while the command is still going.
    """
    for step in (1, 2, 3):
        with open(path, "w") as handle:
            handle.write(f"step={step}\ntotal=3\nlabel=Step {step}\n")
        time.sleep(0.3)


def main() -> int:
    args = sys.argv[1:]

    with open(os.environ.get("FAKE_SUBSTACK_ARGV", DEFAULT_RECORD), "w") as handle:
        json.dump(args, handle)

    if "--check" in args:
        print("ok=1")
        print("publication=https://example.substack.com")
        print("user=Example Person")
        return 0

    path = progress_file(args)
    if path:
        report_progress(path)

    published = "--publish" in args
    scheduled = "--schedule" in args
    status = "published" if published else "scheduled" if scheduled else "draft"
    print(f"status={status}")
    print("url=https://example.substack.com/p/example")
    print("draft_id=12345")
    print("slug=example")
    print("photos=3")
    going_out = published or scheduled
    print(f"emailed={1 if going_out and '--no-email' not in args else 0}")
    print("notified_ok=0")
    print("notified_failed=0")
    when = args[args.index("--schedule") + 1] if scheduled else ""
    print(f"scheduled_for={when}")
    print(f"messages_check={'ok' if scheduled and '--notify' in args else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
